# Backend only. Copy to .env.local, restrict permissions to 0600, then set a new key.
# Never use a VITE_ variable for credentials or add a real key to this template.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_DRAFT_MODEL=gpt-5.4-mini
# Optional HTTP CONNECT proxy, used only for OpenAI requests.
# Example on the server: http://127.0.0.1:18080
OPENAI_PROXY_URL=

# Optional pharmacy inventory export. See README for the JSON format.
# No feed = nearby pharmacies with unknown stock and manual cost calculation.
RYADOM_PHARMACY_FEED=
# Main deployment uses VK Maps' public Overpass instance.
# Override with your own Overpass-compatible service when needed.
RYADOM_OVERPASS_URL=https://maps.mail.ru/osm/tools/overpass/api/interpreter
# Optional fallback; only queried when the primary service fails.
RYADOM_OVERPASS_FALLBACK_URL=https://overpass-api.de/api/interpreter
# Optional Nominatim-compatible search endpoint. Not enabled by default.
# Select a provider and check its terms before enabling address search.
RYADOM_GEOCODER_URL=
