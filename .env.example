# Backend only. Copy to .env.local, restrict permissions to 0600, then set a new key.
# Never use a VITE_ variable for credentials or add a real key to this template.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_DRAFT_MODEL=gpt-5.4-mini
# Optional HTTP CONNECT proxy, used only for OpenAI requests.
# Example on the server: http://127.0.0.1:18080
OPENAI_PROXY_URL=
